  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@sdumeet/shared": "workspace:*",
    "@tarojs/components": "^4.0.6",
