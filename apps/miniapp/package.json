{
  "name": "@sdumeet/miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "SDUMeet 微信小程序（Taro 4 + React + TypeScript）",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc -p tsconfig.json --noEmit"
