# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- 数据库（与根目录 docker-compose.yml 保持一致）----
DATABASE_URL=postgres://sdumeet:sdumeet_dev@localhost:5432/sdumeet

# ---- 认证 ----
# 生产环境务必更换为高强度随机值（openssl rand -base64 48）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- 校园统一身份认证（对接前为占位符）----
# 优先对接山大 CAS/OAuth；未拿到授权前走「学号 + 山大邮箱验证码」降级方案
CAS_BASE_URL=https://pass.example.edu.cn
CAS_CLIENT_ID=
CAS_CLIENT_SECRET=

# ---- 邮件验证码（降级认证方案用，生产接入真实 SMTP）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- 内容安全审核（数美/腾讯云天御等，按需接入）----
AUDIT_PROVIDER=
AUDIT_SECRET_ID=
AUDIT_SECRET_KEY=

# ---- 跨域 ----
CORS_ORIGINS=*
